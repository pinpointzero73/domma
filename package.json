{
    "name": "domma-js",
    "version": "1.1.0",
    "description": "Dynamic Object Manipulation & Modeling API - A complete front-end toolkit.",
    "main": "public/dist/domma.min.js",
    "module": "public/dist/domma.esm.js",
    "types": "assets/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./assets/types/index.d.ts",
            "import": "./public/dist/domma.esm.js",
            "default": "./public/dist/domma.esm.js"
        },
        "./css": "./public/dist/domma.css",
        "./elements.css": "./public/dist/elements.css",
        "./grid.css": "./public/dist/grid.css",
        "./syntax.css": "./public/dist/syntax.css",
        "./syntax": "./public/dist/domma-syntax.min.js",
        "./flags": {
            "import": "./public/dist/domma-flags.esm.js",
            "default": "./public/dist/domma-flags.min.js"
        },
        "./themes/*": "./public/dist/themes/*",
        "./bundles/*": "./public/dist/bundles/*",
        "./types": "./assets/types/index.d.ts",
        "./types/catalogue.json": "./assets/types/catalogue.json",
        "./package.json": "./package.json",
        "./public/*": "./public/*",
        "./assets/*": "./assets/*",
        "./templates/*": "./templates/*",
        "./bin/*": "./bin/*"
    },
    "bin": {
        "domma": "./bin/domma-cli.js"
    },
    "files": [
        "bin/",
        "templates/kickstart/",
        "templates/kickstart-spa/",
        "templates/page-template/",
        "templates/view-template/",
        "public/dist/domma.min.js",
        "public/dist/domma.min.js.map",
        "public/dist/domma.esm.js",
        "public/dist/domma.esm.js.map",
        "public/dist/domma.css",
        "public/dist/bundles/",
        "public/dist/elements.css",
        "public/dist/grid.css",
        "public/dist/syntax.css",
        "public/dist/domma-syntax.min.js",
        "public/dist/domma-syntax.min.js.map",
        "public/dist/domma-flags.min.js",
        "public/dist/domma-flags.min.js.map",
        "public/dist/domma-flags.esm.js",
        "public/dist/domma-flags.esm.js.map",
        "public/dist/themes/",
        "assets/types/",
        "LICENSE",
        "README.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pinpointzero73/domma.git"
    },
    "type": "module",
    "scripts": {
        "start": "node bin/domma-cli.js serve",
        "serve": "node bin/domma-cli.js serve",
        "serve:3096": "node bin/domma-cli.js serve --port 3096",
        "dev": "NODE_ENV=development npm run generate:bundles && rollup -c && node scripts/build-info.js && npm run build:metadata && npm run copy:themes && npm run copy:celebrate && npm run generate:themes && npm run build:css && npm run build:miniapps && live-server public --port=3001 --open=/index.html",
        "dev:watch": "NODE_ENV=development npm run generate:bundles && rollup -c && node scripts/build-info.js && npm run build:metadata && npm run copy:themes && npm run copy:celebrate && npm run generate:themes && npm run build:css && npm run build:miniapps && npm run watch:miniapps",
        "build": "npm run generate:bundles && rollup -c && node scripts/build-info.js && npm run build:metadata && npm run copy:themes && npm run copy:celebrate && npm run generate:themes && npm run build:css && npm run build:css-bundles && npm run build:archives && npm run build:types && npm run build:kickstart-files && npm run build:miniapps",
        "build:js": "rollup -c",
        "build:types": "node scripts/build-types.mjs && node scripts/build-type-catalogue.mjs",
        "check:types": "node scripts/check-types.mjs",
        "build:css": "node scripts/build-css.js",
        "validate:classes": "node scripts/validate-classes.js",
        "validate:theme": "node scripts/validate-theme-contrast.js",
        "validate:contrast": "node scripts/validate-contrast-pairs.js",
        "validate:conventions": "node scripts/validate-conventions.js",
        "sweep:themes": "node scripts/sweep-themes.js",
        "sweep:site": "node scripts/sweep-site-contrast.js",
        "validate:showcase": "vitest run src/showcase-pages.test.js",
        "validate:showcase:strict": "SHOWCASE_STRICT=1 vitest run src/showcase-pages.test.js",
        "validate:showcase:baseline": "SHOWCASE_BASELINE=1 vitest run src/showcase-pages.test.js",
        "validate": "npm run validate:classes && npm run validate:theme && npm run validate:contrast && npm run validate:conventions && npm run sweep:site",
        "build:css-bundles": "node scripts/build-css-bundles.js",
        "build:archives": "node scripts/build-archives.js",
        "build:kickstart-files": "node scripts/build-kickstart-files.js",
        "build:info": "node scripts/build-info.js",
        "build:metadata": "node scripts/copy-metadata.js",
        "copy:themes": "node scripts/copy-theme-css.js",
        "build:miniapps": "node scripts/build-miniapp.js && node scripts/copy-miniapps.js",
        "watch:miniapps": "node scripts/watch-miniapps.js",
        "generate:bundles": "node scripts/generate-bundles.js",
        "generate:themes": "node scripts/generate-admin-themes.js",
        "test:vitest": "vitest",
        "test": "vitest",
        "cypress:run": "cypress run",
        "copy:celebrate": "node scripts/copy-celebrate.js"
    },
    "keywords": [
        "dom",
        "http",
        "utils",
        "toolkit",
        "json-config"
    ],
    "author": "Darryl Waterhouse",
    "license": "ISC",
    "engines": {
        "node": ">=24"
    },
    "devDependencies": {
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-replace": "^6.0.3",
        "@rollup/plugin-terser": "^1.0.2",
        "@vitest/coverage-v8": "^5.1.0",
        "cypress": "^16.2.1",
        "domma-celebrate": "1.5.0",
        "domma-reactive": "1.3.2",
        "dompurify": "^3.4.17",
        "dotenv": "^18.0.9",
        "jsdom": "^31.0.0",
        "live-server": "^1.2.2",
        "puppeteer": "^25.16.0",
        "rollup": "^4.68.0",
        "typescript": "7.0.2",
        "vitest": "^5.1.0",
        "typescript-compiler-api": "npm:typescript@6.0.3"
    },
    "dependencies": {},
    "overrides": {
        "live-server": {
            "chokidar": "^3.6.0"
        }
    }
}

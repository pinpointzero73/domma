{
  "name": "domma",
  "version": "1.0.0",
  "description": "Dynamic Object Manipulation & Modeling API - A complete front-end toolkit.",
  "main": "public/dist/domma.min.js",
  "module": "public/dist/domma.esm.js",
  "types": "assets/types/index.d.ts",
  "type": "module",
  "scripts": {
    "dev": "live-server public --port=3000 --open=/index.html",
    "build": "node scripts/build-info.js && rollup -c && npm run build:css",
    "build:js": "rollup -c",
    "build:css": "node scripts/build-css.js",
    "build:info": "node scripts/build-info.js",
    "test": "node tests/test.js",
    "showcase": "live-server public --port=3000 --open=/showcase/index.html"
  },
  "keywords": [
    "dom",
    "http",
    "utils",
    "toolkit",
    "json-config"
  ],
  "author": "Darryl Waterhouse",
  "license": "ISC",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "live-server": "^1.2.0",
    "rollup": "^4.28.0",
    "rollup-plugin-obfuscator": "^1.1.0"
  }
}

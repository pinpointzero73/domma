{
  "project": {
    "name": "{{projectName}}",
    "version": "1.0.0",
    "description": "A Domma-powered Single Page Application"
  },
  "spa": {
    "enabled": true,
    "container": "#app",
    "defaultRoute": "/",
    "notFoundView": "404",
    "transitions": {
      "enter": "fadeIn",
      "leave": "fadeOut",
      "duration": 200
    },
    "persistScroll": false
  },
  "theme": {
    "default": "{{theme}}",
    "selector": {{includeThemeSelector}},
    "persist": true,
    "autoDetect": false
  },
  "navbar": {
    "brand": {
      "text": "{{projectName}}",
      "logo": "assets/logo/placeholder.svg",
      "url": "#/"
    },
    "items": [
      {
        "text": "Home",
        "url": "#/",
        "active": true
      },
      {
        "text": "About",
        "url": "#/about"
      },
      {
        "text": "Contact",
        "url": "#/contact"
      }
    ],
    "variant": "dark",
    "position": "sticky",
    "collapsible": true,
    "collapseAt": "md"
  },
  "routes": [
    {
      "path": "/",
      "view": "home",
      "title": "{{projectName}} - Home"
    },
    {
      "path": "/about",
      "view": "about",
      "title": "{{projectName}} - About"
    },
    {
      "path": "/contact",
      "view": "contact",
      "title": "{{projectName}} - Contact"
    }
  ],
  "footer": {
    "copyright": "© {{year}} {{projectName}}. All rights reserved.",
    "links": [
      {
        "text": "Privacy Policy",
        "url": "#/privacy"
      },
      {
        "text": "Terms of Service",
        "url": "#/terms"
      }
    ]
  },
  "features": {
    "icons": true,
    "backToTop": true,
    "smoothScroll": true
  }
}

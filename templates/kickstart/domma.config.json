{
  "project": {
    "name": "{{projectName}}",
    "version": "1.0.0",
    "description": "A Domma-powered web project"
  },
  "theme": {
    "default": "{{theme}}",
    "selector": "{{includeThemeSelector}}",
    "persist": true,
    "autoDetect": false
  },
  "navbar": {
    "brand": {
      "text": "{{projectName}}",
      "logo": "assets/logo/placeholder.svg",
      "url": "/"
    },
    "items": [
      {
        "text": "Home",
        "url": "/",
        "active": true
      },
      {
        "text": "About",
        "url": "/about/"
      },
      {
        "text": "Contact",
        "url": "/contact/"
      },
      {
        "text": "Blog",
        "url": "/blog/"
      },
      {
        "text": "Docs",
        "url": "/docs/"
      },
      {
        "text": "QuickStart",
        "url": "https://github.com/dcbw-it/domma#quick-start-with-cli-recommended",
        "badge": "New"
      }
    ],
    "variant": "dark",
    "position": "sticky",
    "collapsible": true
  },
  "footer": {
    "copyright": "© {{year}} {{projectName}}. All rights reserved.",
    "links": [
      {
        "text": "Privacy Policy",
        "url": "#privacy"
      },
      {
        "text": "Terms of Service",
        "url": "#terms"
      },
      {
        "text": "Contact Us",
        "url": "/contact/"
      }
    ]
  },
  "features": {
    "icons": true,
    "backToTop": true,
    "codeCopy": true,
    "smoothScroll": true
  }
}

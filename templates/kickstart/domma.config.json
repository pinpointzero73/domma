{
  "project": {
    "name": "{{projectName}}",
    "version": "1.0.0",
    "description": "A Domma-powered web project"
  },
  "theme": {
    "default": "{{theme}}",
    "selector": "{{includeThemeSelector}}",
    "persist": true,
    "autoDetect": false
  },
  "navbar": {
    "brand": {
      "text": "{{projectName}}",
      "logo": "assets/logo/placeholder.svg",
      "url": "pages/"
    },
    "items": [
      {
        "text": "Home",
        "url": "pages/",
        "active": true
      },
      {
        "text": "About",
        "url": "pages/about/"
      },
      {
        "text": "Contact",
        "url": "pages/contact/"
      },
      {
        "text": "Blog",
        "url": "pages/blog/"
      },
      {
        "text": "Docs",
        "url": "pages/docs/"
      },
      {
        "text": "QuickStart",
        "url": "https://dommajs.org/docs/getting-started",
        "badge": "Docs"
      }
    ],
    "variant": "dark",
    "position": "sticky",
    "collapsible": true
  },
  "footer": {
    "copyright": "© {{year}} {{projectName}}. All rights reserved.",
    "links": [
      {
        "text": "Privacy Policy",
        "url": "pages/privacy/"
      },
      {
        "text": "Cookie Policy",
        "url": "pages/cookies/"
      },
      {
        "text": "Terms of Service",
        "url": "pages/terms/"
      },
      {
        "text": "Contact Us",
        "url": "pages/contact/"
      }
    ]
  },
  "features": {
    "icons": true,
    "backToTop": true,
    "codeCopy": true,
    "smoothScroll": true
  }
}
